{
  "manifestVersion": 1,
  "id": "initiative-tracker",
  "name": "Initiative Tracker",
  "group": "D&D",
  "description": "Turn order, conditions, AC and HP for TTRPG encounters.",
  "install": [
    { "type": "git", "requires": ["node", "npm"], "setup": "npm ci", "launch": "npm start" }
  ],
  "cloud": {
    "include": ["encounters/*.json", "custom/*.json"],
    "maxSizeMB": 20
  }
}
